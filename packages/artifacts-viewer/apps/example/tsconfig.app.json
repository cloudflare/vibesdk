{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    // Mirrors the dev-only aliases in vite.config.ts so the editor reads
    // library source. Keep the two in sync when adding a subpath export.
    "paths": {
      "artifacts-viewer/client": ["../../packages/artifacts-viewer/src/client/index.ts"],
      "artifacts-viewer/react": ["../../packages/artifacts-viewer/src/react/index.ts"]
    }
  },
  "include": ["src"]
}
